<div class="main-content-container" style="padding: 113px 20px 20px; overflow: auto">
      <table class="sf_table">
        <thead>
          <tr>
            <th class="chckbx_col"><input type="checkbox" class="sf-checkbox" name="all"></th>
            <th class="title_col">_('Title')</th>
            <th>_('Author')</th>
            <th>_('Publish date')</th>
            <th>_('Status')</th>
            <th class="action_col">


            </th>
          </tr>
        </thead>
        <tbody>

          <tr>
            <td class="chckbx_col"><input type="checkbox" class="sf-checkbox" set-bg="2"  name="article_1"></td>
            <td class="title_col"><a href="javascript:void(0)" data-action="edit">Liveblog-Test Baselland</a></td>
            <td>David Bauer</td>
            <td>2013-03-10 13:32:20</td>
            <td>Published</td>
            <td class="action_col">
              <div class="dropdown">
                <a href="#" class="dropdown-toggle" data-toggle="dropdown">Action <b class="caret"></b></a>
                <ul class="dropdown-menu sf-dropdown-simple pull-right">
                  <li><a href="javascript:void(0)" data-action="edit"><i class="icon-pencil"></i> Edit</a></li>
                  <li><a href="javascript:void(0)"><i class="icon-trash"></i> Delete</a></li>
                  <li><a href="javascript:void(0)"><i class="icon-ban-circle"></i> Unpublish</a></li>
                  <li><a href="javascript:void(0)"><i class="icon-eye-open"></i> Preview</a></li>
                </ul>
              </div>
            </td>
          </tr>

          

        </tbody>
      </table>
      <div class="main-content-subnav" style="position: static">
      	{#pagination}
      	<div class="pagination" style="margin-top:0">
      		{?currentpages}
      		<ul class="{className}">
      			<li> <a href="javascript:void(0)" data-pagination="first" title="_('First')">&#8676;</a> </li>
      			<li> <a href="javascript:void(0)" data-pagination="prev" title="_('Previous')">&larr;</a> </li> 
      			{#currentpages}
      			<li class="{className}"> 
      				<a href="javascript:void(0)" data-pagination="currentpages" title="_('Page') {page}" data-offset="{offset}">{page}</a> 
      			</li>	
      			{/currentpages}
      			<li> <a href="javascript:void(0)" data-pagination="next" title="_('Next')">&rarr;</a> </li>
      			<li> <a href="javascript:void(0)" data-pagination="last" title="_('Last')">&#8677;</a> </li>
      		</ul>
      		{/currentpages}
      	</div>
      	{/pagination}
      </div>
   </div>



