    height: 40px;
    left: 0;
    position: fixed;
    right: 0;
    top: 93px;
    z-index: 100;
}
.edit-toolbar
{
	padding: 0; 
	margin: 0;
	background: none;
	border: none;
	max-width: 100%;
	margin: 0 auto;
    position: relative !important;
    top: auto !important;
    width: 566px;
}
#main-article section header
{
	visibility: hidden;
}
#main-article:hover section *
{
	visibility: visible;
}
</style>

