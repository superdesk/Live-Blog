{>"livedesk>layouts/livedesk"/}
{<body}
<section class="scroller main-section configure-blog" {ui.content}>
	<header>
		<h3>_('Managed feeds')</h3>
	</header>
	<div class="row-fluid">
		<div class="span8">
			<div class="manage-feeds-top">
				<div class="sf-searchbox">
					<input type="text" placeholder="Search"><a href="#"><i class="icon-remove"></i></a>
				</div>
				<a class="btn btn-info pull-right" data-toggle="modal" href="#AddSource"><span class="medium-icon-add"></span> Add New Source</a>
			</div>
			<ul class="manage-feeds" id="provider-list">
            </ul>
      </div>
    </div>
</section>

<div class="modal hide fade" id="AddSource">
  <div class="modal-header">
    <a href="#" class="close" data-dismiss="modal" aria-hidden="true">×</a>
    <h3>_("Add Provider");</h3>
  </div>
  <div class="modal-body">
    <form name="add">
        <input type="text" name="Title" placeholder="_('Blog Provider Title');" value="" class="fullwidth-input">
        <input type="text" name="URL" placeholder="_('Blog Provider URL');" value="" class="fullwidth-input">
    </form>
  </div>
  <div class="modal-footer">
    <a href="#" class="btn" data-dismiss="modal">Cancel</a>
    <a href="#" class="btn btn-primary" id="add-provider-save">Save</a>
  </div>
</div>
{/body}
